# ------------------------------------------------------------------
# Backend environment variables. Copy to `.env` and fill in real values.
# NEVER commit the real .env file.
# ------------------------------------------------------------------

# App / CORS
FRONTEND_URL=http://localhost:5173

# --- Coding platform usernames (already set to verified defaults) ---
GITHUB_USERNAME=Sriram-ake
LEETCODE_USERNAME=akesriram
CODECHEF_USERNAME=akesriram_2007
HACKERRANK_USERNAME=akesurekha
GEEKSFORGEEKS_USERNAME=akesriram
CODEFORCES_USERNAME=Sriram_2007

# Optional: GitHub personal access token (read-only) for higher rate limits.
GITHUB_TOKEN=

# Coding statistics cache TTL, in seconds (default 3600 = 1 hour).
CODING_CACHE_TTL=3600

# --- NVIDIA NIM (AI assistant) ---
# Without a key, the assistant falls back to a grounded rule-based responder.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Brevo (contact form email) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Portfolio Contact Form
CONTACT_RECEIVER_EMAIL=akesurekha@gmail.com

# --- Contact rate limiting ---
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW=3600
