# Production build config (loaded automatically by `vite build`).
#
# The frontend and backend live on different origins in production, so the API
# base URL must be baked into the bundle at build time. Without this, API_BASE
# is empty and the app calls `/api/*` on its own static host (no backend there),
# which is why the GitHub and Coding sections showed "unavailable".
#
# A Render dashboard env var of the same name still overrides this if set.
VITE_API_BASE_URL=https://akesriram-api.onrender.com
